{
  "name": "WhatsApp Management",
  "author": {
    "name": "Bruno Gabriel",
    "email": "bruno.gabriel@portta.com.br"
  },
  "defaultLocale": "pt-BR",
  "private": true,
  "location": {
    "support": {
      "top_bar": {
        "url": "assets/iframe.html"
      },
      "ticket_sidebar": {
        "url": "assets/iframe.html",
        "autoLoad": true,
        "flexible": true
      },
      "user_sidebar": {
        "url": "assets/iframe.html",
        "autoLoad": true
      },
      "nav_bar": {
        "url": "assets/iframe.html",
        "flexible": true
      },
      "modal": {
        "url": "assets/iframe.html"
      }
    }
  },
  "version": "0.1.0",
  "frameworkVersion": "2.0",
  "domainWhitelist": [
    "apps.portta.com.br",
    "*.zendesk.com"
  ],
  "parameters": [
    {
      "name": "sunshine_app_id",
      "type": "text",
      "required": true
    },
    {
      "name": "sunshine_key_id",
      "type": "text",
      "required": true
    },
    {
      "name": "sunshine_secret",
      "type": "text",
      "secure": true,
      "scopes": ["basic_auth_password"],
      "required": true
    },
    {
      "name": "whatsapp_integration_id",
      "type": "text",
      "required": false
    },
    {
      "name": "meta_portfolio_id",
      "type": "text",
      "required": false
    },
    {
      "name": "auto_merge_contacts",
      "type": "checkbox",
      "default": false,
      "required": false
    },
    {
      "name": "auto_merge_tickets",
      "type": "checkbox",
      "default": false,
      "required": false
    }
  ]
}
