{
  "name": "WhatsApp Management",
  "author": {
    "name": "Bruno Gabriel",
    "email": "brudarko@gmail.com"
  },
  "defaultLocale": "pt-BR",
  "private": true,
  "location": {
    "support": {
      "top_bar": {
        "url": "assets/iframe.html"
      },
      "ticket_sidebar": {
        "url": "assets/iframe.html",
        "autoLoad": true,
        "flexible": true
      },
      "ticket_editor": {
        "url": "assets/iframe.html",
        "flexible": true
      },
      "user_sidebar": {
        "url": "assets/iframe.html",
        "autoLoad": true
      },
      "nav_bar": {
        "url": "assets/iframe.html",
        "flexible": true
      }
    }
  },
  "version": "0.1.0",
  "frameworkVersion": "2.0",
  "domainWhitelist": [
    "{{setting.outbound_service_host}}",
    "*.zendesk.com"
  ],
  "parameters": [
    {
      "name": "sunshine_app_id",
      "type": "text",
      "required": true
    },
    {
      "name": "sunshine_key_id",
      "type": "text",
      "required": true
    },
    {
      "name": "sunshine_secret",
      "type": "text",
      "secure": true,
      "required": true
    },
    {
      "name": "whatsapp_integration_id",
      "type": "text",
      "required": false
    },
    {
      "name": "meta_portfolio_id",
      "type": "text",
      "required": false
    },
    {
      "name": "auto_merge_contacts",
      "type": "checkbox",
      "default": false,
      "required": false
    },
    {
      "name": "outbound_service_host",
      "type": "text",
      "required": false
    },
    {
      "name": "outbound_service_token",
      "type": "text",
      "secure": true,
      "scopes": [
        "header"
      ],
      "required": false
    }
  ]
}
