# Serviço de envio (server/index.mjs). Nenhum valor real aqui: copie para .env
# ou exporte no ambiente da hospedagem. `npm run start:local` gera OUTBOUND_SERVICE_TOKEN
# e OUTBOUND_DATA_DIR sozinho; em produção defina os dois.

# Zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_TOKEN=
OUTBOUND_AGENT_IDS=

# Sunshine Conversations (canal WhatsApp conectado ao Zendesk)
SUNSHINE_APP_ID=
SUNSHINE_KEY_ID=
SUNSHINE_SECRET=
WHATSAPP_INTEGRATION_ID=
META_PORTFOLIO_ID=

# Serviço
OUTBOUND_SERVICE_TOKEN=
OUTBOUND_DATA_DIR=
PORT=8787

# Gerenciamento avançado na Meta (opcional; sem isso os formatos avançados não são submetidos)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_ACCESS_TOKEN=
META_WABA_ID=
META_GRAPH_VERSION=v21.0
META_REDIRECT_URI=
